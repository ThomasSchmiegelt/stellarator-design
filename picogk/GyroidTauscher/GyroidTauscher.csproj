<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Pfad zum PicoGK-Quellcode; ueberschreibbar: dotnet build -p:PicoGKPfad=/pfad/zu/PicoGK -->
    <PicoGKPfad Condition="'$(PicoGKPfad)' == ''">$(HOME)/ai-workspace/pikogk/PicoGK</PicoGKPfad>
  </PropertyGroup>

  <!-- Lokaler PicoGK-Quellcode (Linux-Build); das NuGet-Paket enthaelt keine linux-x64-Runtime. -->
  <ItemGroup>
    <ProjectReference Include="$(PicoGKPfad)/PicoGK.csproj" />
  </ItemGroup>

</Project>
