# Whitelist: alles ignorieren, dann gezielt freigeben (Rechenergebnisse sind gross und reproduzierbar)
/*
!/README.md
!/LICENSE
!/.gitignore
!/BEFUNDE.md
!/ERINNERUNGEN.md
!/requirements.txt
!/requirements-opt.txt
!/docs/
!/stellarator/
!/invers/
!/forschung/
!/picogk/
!/sim/
!/bericht/
/bericht/*
!/bericht/projektbericht/
!/bericht/v0.3/
!/bericht/surrogat/
/sim/*
!/sim/pipeline/

# Build / Laufzeit
__pycache__/
*.pyc
picogk/**/bin/
picogk/**/obj/
.env
# Validierungsfall: Netze/Ergebnisse werden von run_validierung.sh erzeugt
sim/pipeline/**/wire2d/
sim/pipeline/**/*.vtu

# Berichte: nur Projektbericht (de/en, Quellen geprueft) und v0.3; v0.1/v0.2/Spulen-Recherche mit ungeprueften Zitaten lokal
bericht/**/*.aux
bericht/**/*.log
bericht/**/*.out
bericht/**/*.toc
