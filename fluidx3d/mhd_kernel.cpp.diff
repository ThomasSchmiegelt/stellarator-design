+	uxx x0, xp, xm, y0, yp, ym, z0, zp, zm;
+	calculate_indices(n, &x0, &xp, &xm, &y0, &yp, &ym, &z0, &zp, &zm);
+	uxx nb[6];
+	nb[0] = xp+y0+z0; nb[1] = xm+y0+z0; nb[2] = x0+yp+z0; nb[3] = x0+ym+z0; nb[4] = x0+y0+zp; nb[5] = x0+y0+zm;
+	const float3 bb = (float3)(def_mhd_b);
+	const float3 wn = cross(load3(u, n), bb);
+	float s = 0.0f, c = 0.0f;
+	for(uint i=0u; i<6u; i++) {
+		const float3 d = (float3)(i==0u ? 1.0f : i==1u ? -1.0f : 0.0f, i==2u ? 1.0f : i==3u ? -1.0f : 0.0f, i==4u ? 1.0f : i==5u ? -1.0f : 0.0f);
+		const uxx m = nb[i];
+		if((flags[m]&TYPE_BO)==TYPE_S) {
+			if(def_mhd_wand==1 && fabs(dot(d, bb))>0.5f) { c += 2.0f; } // ideal leitende Wand: phi = 0 auf der Wandflaeche (halbe Zelle entfernt, dort u = 0)
+		} else {
+			const float3 wf = 0.5f*(wn+cross(load3(u, m), bb));
+			s += pin[m]-dot(wf, d); c += 1.0f;
+		}
+	}
+	pout[n] = c>0.0f ? s/c : 0.0f;
+}
